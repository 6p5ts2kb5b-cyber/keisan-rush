{
  "name": "manabi-rush",
  "version": "1.0.0",
  "private": true,
  "description": "まなびラッシュ（App Store 版）",
  "scripts": {
    "build:web": "python3 tools/build_app.py",
    "ios:add": "npx cap add ios",
    "ios:assets": "npx capacitor-assets generate --ios",
    "ios:setup": "bash tools/ios_setup.sh",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/preferences": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@capacitor/assets": "^3.0.5"
  }
}
